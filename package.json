{
  "name": "palafoxiana",
  "version": "1.0.0",
  "description": "Concept redesign (educational portfolio) of the Biblioteca Palafoxiana website. HTML, CSS and JavaScript with no runtime dependencies. Not affiliated with the institution.",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . && stylelint \"styles.css\" \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abarriuso/palafoxiana-redesign.git"
  },
  "keywords": [],
  "author": "Adrián Barriuso Pizarro",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/abarriuso/palafoxiana-redesign/issues"
  },
  "homepage": "https://github.com/abarriuso/palafoxiana-redesign#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "sharp": "0.35.4",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "vitest": "^5.0.1"
  }
}
